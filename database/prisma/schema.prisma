// Prisma schema for AI Travel Companion

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TripStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TransportType {
  FLIGHT
  TRAIN
  BUS
  CAR
}

enum NotificationType {
  WEATHER
  BOARDING
  ACTIVITY
  BUDGET
  SYSTEM
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  name         String
  avatar       String?
  role         Role             @default(USER)
  provider     String           @default("email")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  profile      Profile?
  preferences  UserPreferences?
  sessions     UserSession[]
  trips        Trip[]
  generations  AIGeneration[]
  savedPlaces  SavedPlace[]
  notifications Notification[]
  feedbacks    Feedback[]
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  avatar    String?
  provider  String   @default("email")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPreferences {
  id                 String  @id @default(uuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCurrency  String  @default("INR")
  travelStyle        String  @default("Balanced")
  theme              String  @default("dark")
  emailNotifications Boolean @default(true)
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SavedPlace {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  address   String
  rating    Float    @default(4.5)
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model WeatherCache {
  id        String   @id @default(uuid())
  city      String   @unique
  temp      Float
  data      Json
  expiresAt DateTime
}

model EmergencyContact {
  id              String @id @default(uuid())
  country         String @unique
  police          String @default("112")
  ambulance       String @default("108")
  touristHelpline String @default("1363")
}

model AIGeneration {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId         String?
  prompt         String
  rawOutput      String?
  structuredData Json
  version        Int      @default(1)
  createdAt      DateTime @default(now())
}

model ItineraryVersion {
  id            String   @id @default(uuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  data          Json
  createdAt     DateTime @default(now())
}

model Trip {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  destination      String
  country          String?            @default("India")
  city             String?
  startDate        DateTime
  endDate          DateTime
  budget           Float
  spent            Float              @default(0)
  currency         String             @default("INR")
  coverImage       String?
  status           TripStatus         @default(UPCOMING)
  travelType       String?            @default("Balanced")
  transportType    String?            @default("Flight")
  accommodation    String?
  description      String?
  isFavorite       Boolean            @default(false)
  isArchived       Boolean            @default(false)
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  itineraryDays    ItineraryDay[]
  packingItems     PackingItem[]
  expenses         Expense[]
  memories         Memory[]
  transportTickets TransportTicket[]
  versions         ItineraryVersion[]
}

model ItineraryDay {
  id         String     @id @default(uuid())
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber  Int
  date       DateTime
  summary    String?
  activities Activity[]
}

model Activity {
  id             String       @id @default(uuid())
  itineraryDayId String
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  time           String
  title          String
  description    String?
  location       String?
  lat            Float?
  lng            Float?
  category       String       @default("Sightseeing")
  cost           Float        @default(0)
  isCompleted    Boolean      @default(false)
}

model PackingItem {
  id       String  @id @default(uuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category String  @default("General")
  itemName String
  isPacked Boolean @default(false)
  quantity Int     @default(1)
}

model Expense {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  currency    String   @default("INR")
  description String
  date        DateTime @default(now())
}

model Memory {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  aiCaption String?
  location  String?
  createdAt DateTime @default(now())
}

model TransportTicket {
  id            String        @id @default(uuid())
  tripId        String
  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type          TransportType @default(FLIGHT)
  carrierNumber String
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  status        String        @default("On Time")
  terminal      String?
  gate          String?
  platform      String?
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   @default("INFO")
  message   String
  source    String
  timestamp DateTime @default(now())
}
